# GitPing Configuration
# Copy this file to `.env.local` and fill in the values you need.

# GitHub Personal Access Token (optional, raises rate limit from 60 to 5,000 req/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# SMTP Configuration (optional, powers email alerts)
# For Gmail: enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
# Other options: Resend, Brevo, Mailtrap, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# Optional: custom From address (defaults to "GitPing <SMTP_USER>")
SMTP_FROM=

# Optional: fallback alert recipient email
GITPING_ALERT_EMAIL=

# Persistent storage for Vercel deployments. Attach a Vercel KV database, then
# copy these values from the integration's environment variables.
KV_REST_API_URL=
KV_REST_API_TOKEN=
